; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Forced-Entry"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"
von/server_path="/Users/athomasson/.venvs/von/bin/von"
debug/command_port=9080

[autoload]

Keybinds="*res://scenes/general/keybinds.gd"
Despawner="*res://scenes/general/despawner.gd"
EventBus="*res://scenes/general/event_bus.gd"
GameClock="*res://scenes/general/game_clock.gd"
Sound="*res://scenes/audio/sound.gd"

[debug]

file_logging/enable_file_logging=true

[dotnet]

project/assembly_name="Example_Godot"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg", "res://addons/ticket_autorun/plugin.cfg")

[gdunit4]

hooks/session_hooks=PackedStringArray("res://scenes/testing/test_report_hook.gd")
report/godot/script_error=false
settings/test/test_lookup_folder="tests"
settings/test/test_discovery=true
ui/toolbar/run_overall=true
