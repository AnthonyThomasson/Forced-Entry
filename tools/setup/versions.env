# Every pinned version the setup installs, in one place. Plain KEY=value lines: no quotes, no spaces around `=`, no
# ${...} expansion, a line starting with # is a comment. Read by bash (tools/setup/lib.sh: fe_manifest_get), by Windows
# PowerShell 5.1 (tools/setup/lib.ps1: Get-FeManifest) and by Python (tools/setup/fe_env.py: manifest()), with no jq
# and no Python needed to read it. Change a pin here and nowhere else.

# Godot: the STANDARD (non-mono) build, pinned exactly (the project has no C#). An existing mono build of the same
# version is accepted wherever a Godot is looked up. The zips are godotengine/godot release assets; the checksums are
# SHA-512, copied from that release's SHA512-SUMS.txt (the win64 one checked against the downloaded zip).
GODOT_VERSION=4.4.1-stable
GODOT_BASE_URL=https://github.com/godotengine/godot/releases/download/4.4.1-stable
GODOT_WIN64_ZIP=Godot_v4.4.1-stable_win64.exe.zip
GODOT_WIN64_SHA512=266978b803f7532edc69bdd5d8c4fdced0ea97aef1224a8879616398a2559e135520e186add06b532aa92bdfeecf6ac024634024de4b3abd69f6c34e6d6d0563
GODOT_MACOS_ZIP=Godot_v4.4.1-stable_macos.universal.zip
GODOT_MACOS_SHA512=e72933ed15db495a29c918b27adc83596b6a4dc59ec72c927e1591333df14f0eb57c515a94f9f5a0ed8a13053d55f6aedf56f2a2d828add2ef3f79c698db714b

# Python the tools run on: this version or newer. The Von venv is built from exactly VON_PYTHON (a newer Python may be
# installed too; the wheels Von's dependencies need, torch above all, lag behind the newest Python).
PYTHON_MIN=3.12
VON_PYTHON=3.12

# Von: the SDK pip installs into the venv under <von home>, and the weights (Hugging Face repo and exact revision)
# downloaded into <von home>/checkpoints/von-1.2.
VON_SDK_VERSION=1.3.1
VON_WEIGHTS_REPO=wfzyx/von
VON_WEIGHTS_REVISION=3a34cbdfaa1e90f2a9eb6b3bfc5ac5c92a18cb01

# skillshare (the skills tool that tools/sync_skills.sh and the bootstrap use): the runkids/skillshare release archives
# and their SHA-256, copied from the release's checksums.txt (the Windows one checked against the downloaded zip).
SKILLSHARE_VERSION=0.30.13
SKILLSHARE_BASE_URL=https://github.com/runkids/skillshare/releases/download/v0.30.13
SKILLSHARE_WIN64_ZIP=skillshare_0.30.13_windows_amd64.zip
SKILLSHARE_WIN64_SHA256=093a5380580bff3c33c265f961be737f0e3b73cdea49bbd338b2481617274462
SKILLSHARE_MACOS_ARM64_TGZ=skillshare_0.30.13_darwin_arm64.tar.gz
SKILLSHARE_MACOS_ARM64_SHA256=6d2493fdb8aa8015e86fa1c3688ecef5e01fd810d4a6a1db5d247b5bb95938bc
SKILLSHARE_MACOS_AMD64_TGZ=skillshare_0.30.13_darwin_amd64.tar.gz
SKILLSHARE_MACOS_AMD64_SHA256=eed7de06d5796c91dc85cc1ab41fa28e23ba5d9c03d5558ae79bfe0723c9c9b7
