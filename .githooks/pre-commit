#!/usr/bin/env bash
# Git pre-commit hook: run the tests a commit can break and abort the commit on failure. It checks what the commit
# holds, not the whole working tree, so another agent's unfinished file in the same worktree never blocks it.
#   - First, every script Godot imports (a .gd under scenes/, tests/, addons/ or sandboxes/) the commit touches must
#     leave the index holding it and its .gd.uid together, or neither: Godot writes a .uid only on import, which
#     headless runs skip. A commit that does not is refused at once, naming each file and the import command
#     (tools/load_check.sh --import); nothing else runs.
#   - The tool tests a staged file can break (`tools/tool_tests.sh --staged`: a staged test module runs itself, a
#     staged file every test module whose code names it; a shared test helper, or a tool file no test names, the whole
#     discovery; none for a file outside tools/ and .githooks/ no tool test reads), silent when they pass.
#   - Staged game code (scenes/, tests/, project.godot): the game tests the staged files can break
#     (`tools/run_tests.sh --changed --staged`, picked from the index). The performance tests (domain perf) are left
#     out: their frame-time budgets fail on a loaded machine, so run them on their own (`tools/run_tests.sh
#     --domain=perf`). tools/run_tests.sh runs the lint of what the commit holds before its first test.
#   - Otherwise, a staged script the lint holds to its rules (a .gd outside addons/ and the coverage tool's fixtures:
#     sandboxes/, tools/ ...), a file of the gdstyle pass (gdstyle.toml, tools/gdstyle.sh, tools/lint_gdstyle.py) or
#     of the lint itself (tools/lint.sh, lint_report.py, lint_scripts.gd / .tscn, the code of tools/lint_rules/ but
#     its tests): the lint of what the commit holds, silent when it passes: `tools/lint_staged.sh --quiet`,
#     tools/lint.sh on the staged scripts (added, copied, modified or renamed, not deleted), or on the whole tree when
#     a gdstyle or lint file is staged (it governs every script).
#   - The lint reads a staged script as it is on disk: a script staged in part is checked with its unstaged hunks too.
#     A finding in a script the commit does not hold (the engine pass reports one a staged script loads) is labelled
#     `not in this commit: <path>`.
# Enable with tools/install_hooks.sh; bypass with `git commit --no-verify`.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

# Paths as they are (core.quotePath off): git would quote a non-ASCII one, and no pattern below would match it.
staged=$(git -c core.quotePath=false diff --cached --name-only)
status=0

# Both sides of a rename (--no-renames lists the old path as deleted), read against what the index holds.
index=$(git -c core.quotePath=false ls-files -- scenes tests addons sandboxes)
unpaired=$(git -c core.quotePath=false diff --cached --name-only --no-renames \
  | grep -E '^(scenes|tests|addons|sandboxes)/.*\.gd(\.uid)?$' | sed 's/\.uid$//' | sort -u \
  | while IFS= read -r gd; do
      grep -qxF -- "$gd" <<<"$index" && has_gd=1 || has_gd=0
      grep -qxF -- "$gd.uid" <<<"$index" && has_uid=1 || has_uid=0
      if [[ $has_gd -eq 1 && $has_uid -eq 0 ]]; then
        echo "  $gd has no $gd.uid"
      elif [[ $has_gd -eq 0 && $has_uid -eq 1 ]]; then
        echo "  $gd.uid has no $gd"
      fi
    done)
if [[ -n "$unpaired" ]]; then
  {
    echo "A script and its .uid are not committed together; commit aborted:"
    echo "$unpaired"
    echo "Write the missing .uid files with tools/load_check.sh --import, then stage each .gd with its .gd.uid"
    echo "(git rm or git mv them together)."
  } >&2
  exit 1
fi

# tools/tool_tests.sh reads the index with git's GIT_* variables and runs the tests without them.
out=$(tools/tool_tests.sh --staged 2>&1)
if [[ $? -ne 0 ]]; then
  {
    echo "Tool tests failed; commit aborted (tools/tool_tests.sh --staged):"
    echo "$out" | grep -E '^tool tests:|^(FAIL|ERROR):|^Ran [0-9]+ test|^FAILED'
  } >&2
  status=1
fi

grep -qE '^(scenes/|tests/|project\.godot$)' <<<"$staged" && game=1 || game=0

if [[ $game -eq 0 ]]; then
  out=$(tools/lint_staged.sh --quiet 2>&1)
  if [[ $? -ne 0 ]]; then
    {
      echo "Lint failed; commit aborted (tools/lint.sh):"
      echo "$out"
      echo "Format a script with tools/gdstyle.sh fmt PATH; fix every other finding in the code."
    } >&2
    status=1
  fi
fi

[[ $game -eq 1 ]] || exit $status

out=$(tools/run_tests.sh --changed --staged --summary --jobs=auto --skip-domain=perf 2>&1)
code=$?
[[ $code -eq 0 ]] && exit $status

if grep -q '^GDScript lint failed' <<<"$out"; then
  # The lint stopped the run before a test: its findings are the whole story (labelled by the runner).
  {
    echo "Lint failed; commit aborted (tools/run_tests.sh --changed --staged):"
    echo "$out"
    echo "Format a script with tools/gdstyle.sh fmt PATH; fix every other finding in the code."
  } >&2
  exit 1
fi
{
  echo "Game tests failed; commit aborted (tools/run_tests.sh --changed --staged --summary --jobs=auto --skip-domain=perf):"
  echo "$out" | grep -E '^(==|FAIL|TIMEOUT|        [✗·~]|        bundle:|        shot:|Logged outside|[0-9]+ passed|no test matched)'
  echo "See the test-debug skill; bundles hold the event log and final state."
} >&2
exit 1
