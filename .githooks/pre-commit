#!/usr/bin/env bash
# Git pre-commit hook: run the tests a commit can break and abort the commit on failure.
#   - First, every script Godot imports (a .gd under scenes/, tests/, addons/ or sandboxes/) the commit touches must
#     leave the index holding it and its .gd.uid together, or neither: Godot writes a .uid only on import, which
#     headless runs skip. A commit that does not is refused at once, naming each file and the import command
#     (tools/load_check.sh --import); nothing else runs.
#   - Staged tools/: the tool tests (`python3 -m unittest discover -s tools -t .`: the lint rules, the coverage tool,
#     audit_scan, this hook), silent when they pass.
#   - Staged game code (scenes/, tests/, project.godot): the affected game tests. The performance tests (domain perf)
#     are left out: their frame-time budgets fail on a loaded machine, so run them on their own
#     (`tools/run_tests.sh --domain=perf`). tools/run_tests.sh lints the tree before its first test.
#   - Otherwise, a staged script the lint holds to its rules (a .gd outside addons/ and the coverage tool's fixtures:
#     sandboxes/, tools/ ...) or a file of the gdstyle pass (gdstyle.toml, tools/gdstyle.sh, tools/lint_gdstyle.py):
#     the lint (`tools/lint.sh --quiet`), silent when it passes.
# Enable with tools/install_hooks.sh; bypass with `git commit --no-verify`.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

staged=$(git diff --cached --name-only)
status=0

# Both sides of a rename (--no-renames lists the old path as deleted), read against what the index holds.
index=$(git ls-files -- scenes tests addons sandboxes)
unpaired=$(git diff --cached --name-only --no-renames \
  | grep -E '^(scenes|tests|addons|sandboxes)/.*\.gd(\.uid)?$' | sed 's/\.uid$//' | sort -u \
  | while IFS= read -r gd; do
      grep -qxF -- "$gd" <<<"$index" && has_gd=1 || has_gd=0
      grep -qxF -- "$gd.uid" <<<"$index" && has_uid=1 || has_uid=0
      if [[ $has_gd -eq 1 && $has_uid -eq 0 ]]; then
        echo "  $gd has no $gd.uid"
      elif [[ $has_gd -eq 0 && $has_uid -eq 1 ]]; then
        echo "  $gd.uid has no $gd"
      fi
    done)
if [[ -n "$unpaired" ]]; then
  {
    echo "A script and its .uid are not committed together; commit aborted:"
    echo "$unpaired"
    echo "Write the missing .uid files with tools/load_check.sh --import, then stage each .gd with its .gd.uid"
    echo "(git rm or git mv them together)."
  } >&2
  exit 1
fi

if grep -qE '^tools/' <<<"$staged"; then
  # Without git's GIT_* variables: git hands the hook GIT_INDEX_FILE (and in a worktree GIT_DIR), and every git a
  # test runs in a throwaway repo of its own would obey them and act on this repo instead.
  out=$(
    while IFS= read -r var; do unset "$var"; done < <(compgen -e | grep '^GIT_')
    python3 -m unittest discover -s tools -t . 2>&1
  )
  if [[ $? -ne 0 ]]; then
    {
      echo "Tool tests failed; commit aborted (python3 -m unittest discover -s tools -t .):"
      echo "$out" | grep -E '^(FAIL|ERROR):|^Ran [0-9]+ test|^FAILED'
    } >&2
    status=1
  fi
fi

grep -qE '^(scenes/|tests/|project\.godot$)' <<<"$staged" && game=1 || game=0

# Read to the end (no grep -q): under pipefail an early exit would fail the first grep on a long list (SIGPIPE).
lintable=$(grep -vE '^(addons/|tools/coverage/tests/fixtures/)' <<<"$staged" \
  | grep -E '\.gd$|^(gdstyle\.toml|tools/gdstyle\.sh|tools/lint_gdstyle\.py)$')
if [[ $game -eq 0 && -n "$lintable" ]]; then
  out=$(tools/lint.sh --quiet 2>&1)
  if [[ $? -ne 0 ]]; then
    {
      echo "Lint failed; commit aborted (tools/lint.sh):"
      echo "$out"
      echo "Format a script with tools/gdstyle.sh fmt PATH; fix every other finding in the code."
    } >&2
    status=1
  fi
fi

[[ $game -eq 1 ]] || exit $status

out=$(tools/run_tests.sh --changed --summary --jobs=auto --skip-domain=perf 2>&1)
code=$?
[[ $code -eq 0 ]] && exit $status

{
  echo "Game tests failed; commit aborted (tools/run_tests.sh --changed --summary --jobs=auto --skip-domain=perf):"
  echo "$out" | grep -E '^(==|FAIL|TIMEOUT|        [✗·~]|        bundle:|        shot:|Logged outside|[0-9]+ passed)'
  echo "See the test-debug skill; bundles hold the event log and final state."
} >&2
exit 1
